PORT = 3333

# DATABASE
TYPEORM_CONNECTION = postgres
TYPEORM_HOST = localhost
TYPEORM_USERNAME = postgres
TYPEORM_PASSWORD = cambiar
TYPEORM_DATABASE = sigeit
TYPEORM_PORT = 5432
TYPEORM_SYNCHRONIZE = true
TYPEORM_LOGGING = false
TYPEORM_SSL = false

# SMTP
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
SMTP_USER = usuario@example.com
SMTP_PASS = cambiar
SMTP_FROM = usuario@example.com
SMTP_SECURE = true
SMTP_SERVICE = 'gmail'

# Lista de orígenes permitidos `CORS`
CORS_ORIGIN = 'http://localhost:4200 http://localhost:4201'

# Indica si los cookies deben ser enviados solo desde orígenes seguros. Es útil para
# el desarrollo en localhost, donde debe ser false para enviar cookies a orígenes
# `http`. En producción debe ser true, para enviar los cookies solo a través de `https`.
SECURE_COOKIE = false

NODE_VERSION = 18.17.1

# Lectura con IA de récords escaneados o en imagen (https://aistudio.google.com/apikey).
# Sin key, solo se importan PDF con texto.
GEMINI_API_KEY =

# Modelos en orden de preferencia (si uno falla por saturación o cuota, se usa el siguiente)
GEMINI_MODEL = gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
